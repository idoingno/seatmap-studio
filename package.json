{
  "version": "1.0.0",
  "description": "Open-source visual editor for meeting rooms, event seating, and space layout planning.",
  "name": "seatmap-studio",
  "private": false,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "webpack --mode=production --node-env=production",
    "build:dev": "webpack --mode=development",
    "build:prod": "webpack --mode=production --node-env=production",
    "test:e2e": "NO_PROXY=127.0.0.1,localhost,::1 no_proxy=127.0.0.1,localhost,::1 playwright test",
    "test:perf": "NO_PROXY=127.0.0.1,localhost,::1 no_proxy=127.0.0.1,localhost,::1 node ./scripts/run-seatmap-perf.js",
    "serve": "webpack serve",
    "serve:dist": "python3 -m http.server 8080 --bind 127.0.0.1 --directory dist",
    "start": "webpack serve"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@playwright/test": "^1.44.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.18.1",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^9.1.3",
    "babel-plugin-import": "1.13.5",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "html-webpack-plugin": "5.5.0",
    "less": "4.1.2",
    "less-loader": "^12.2.0",
    "mini-css-extract-plugin": "^2.9.0",
    "moment-locales-webpack-plugin": "1.2.0",
    "postcss": "^8.4.38",
    "postcss-loader": "^8.1.1",
    "prettier": "2.4.1",
    "style-loader": "3.3.1",
    "svg-sprite-loader": "^6.0.11",
    "svgo-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^4.9.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "workbox-webpack-plugin": "6.3.0"
  },
  "dependencies": {
    "@ant-design/icons": "^4.3.0",
    "@antv/x6": "^2.13.1",
    "@antv/x6-plugin-selection": "^2.1.7",
    "@antv/x6-plugin-snapline": "^2.1.7",
    "@antv/x6-plugin-transform": "^2.1.8",
    "@reduxjs/toolkit": "^1.9.5",
    "ahooks": "^3.7.8",
    "antd": "~4.24.15",
    "exceljs": "^4.3.0",
    "lodash-es": "^4.17.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.2",
    "redux": "^4.2.1",
    "x6-graph": "^1.0.0",
    "x6-hooks": "^1.0.8",
    "x6-html-shape": "^0.4.1",
    "xlsx": "^0.18.5"
  }
}
